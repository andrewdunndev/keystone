    <rect x="36" y="52" width="292" height="192" rx="8" fill="var(--surface)" stroke="var(--border)" stroke-dasharray="4 4"/>
    <rect x="48" y="46" width="44" height="12" fill="var(--bg)"/>
    <text x="70" y="55" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">ROUTES</text>
    <rect x="372" y="52" width="252" height="192" rx="8" fill="var(--surface)" stroke="var(--accent)"/>
    <rect x="384" y="46" width="100" height="12" fill="var(--bg)"/>
