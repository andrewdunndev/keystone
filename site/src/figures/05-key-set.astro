    <!-- arrows -->
    <path d="M312,92 H388" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#keyset-arrow-moss)"/>
    <path d="M312,148 H348 V124 H388" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#keyset-arrow-moss)"/>
    <path d="M312,204 H388" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#keyset-arrow-moss)"/>
    <!-- routes -->
    <rect x="52" y="68" width="260" height="48" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="68" y="88" font-size="12" font-weight="600" fill="var(--text)">GET /server-1/adv</text>
    <text x="68" y="104" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">JWS over both public keys</text>
    <rect x="52" y="124" width="260" height="48" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="68" y="144" font-size="12" font-weight="600" fill="var(--text)">GET /server-1/adv/&lt;thp&gt;</text>
    <text x="68" y="160" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">thp: signing key thumbprint</text>
    <rect x="52" y="180" width="260" height="48" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="68" y="200" font-size="12" font-weight="600" fill="var(--text)">POST /server-1/rec/&lt;kid&gt;</text>
    <text x="68" y="216" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">kid: exchange key thumbprint</text>
    <!-- keys -->
    <rect x="388" y="68" width="220" height="80" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="498" y="94" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">SIGNING KEY</text>
    <text x="498" y="110" text-anchor="middle" font-size="12" font-weight="600" fill="var(--text)">ES512 · P-521</text>
    <text x="498" y="126" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">signs the adv</text>
    <rect x="388" y="156" width="220" height="80" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="498" y="182" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">EXCHANGE KEY</text>
    <text x="498" y="198" text-anchor="middle" font-size="12" font-weight="600" fill="var(--text)">ECMR · P-521</text>
    <text x="498" y="214" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">in the adv · answers rec</text>
    <!-- notes -->
    <text x="182" y="264" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">server-1 → TANG_KEY_SERVER_1</text>
    <text x="498" y="264" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">one curve: P-521 or P-256</text>
  </g>
</svg>
