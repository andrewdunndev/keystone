<svg class="figure-wide" viewBox="0 0 660 296" role="img" aria-label="The key set server-1 is one Worker secret, TANG_KEY_SERVER_1, holding a signing key and an exchange key on one curve: the signing key answers the two adv routes and the exchange key the rec route." font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="keyset-arrow-moss" markerUnits="userSpaceOnUse" markerWidth="9" markerHeight="7" refX="9" refY="3.5" orient="auto"><path d="M0,0 L9,3.5 L0,7 Z" fill="var(--accent)"/></marker>
  </defs>
  <g font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif">
    <rect x="20" y="20" width="620" height="256" rx="6" fill="var(--bg)" stroke="var(--border)"/>
