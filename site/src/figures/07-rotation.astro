<svg class="figure-wide" viewBox="0 0 660 308" role="img" aria-label="Over a rotation the disk gains a clevis slot bound to server-2, unlocks on reboot, loses its server-1 slot, and then server-1 is revoked; copies of the disk taken before the unbind still open with server-1's keys." font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" xmlns="http://www.w3.org/2000/svg">
  <g font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif">
    <rect x="20" y="20" width="620" height="268" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <!-- steps -->
    <text x="202" y="56" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">BOUND</text>
    <text x="202" y="70" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">server-1</text>
    <text x="294" y="56" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">BIND</text>
    <text x="294" y="70" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">server-2</text>
    <text x="386" y="56" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">REBOOT</text>
    <text x="386" y="70" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">unlocks</text>
    <text x="478" y="56" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">UNBIND</text>
    <text x="478" y="70" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">server-1</text>
    <text x="570" y="56" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">REVOKE</text>
    <text x="570" y="70" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">server-1</text>
    <path d="M248,84 V240 M340,84 V240 M432,84 V240 M524,84 V240" fill="none" stroke="var(--border)" stroke-dasharray="4 4"/>
    <!-- rows -->
    <text x="36" y="102" font-size="12" font-weight="600" fill="var(--text)">passphrase</text>
    <text x="36" y="114" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">LUKS slot</text>
    <rect x="160" y="92" width="452" height="24" rx="6" fill="var(--surface)" stroke="var(--border)"/>
    <text x="36" y="142" font-size="12" font-weight="600" fill="var(--text)">server-1</text>
    <text x="36" y="154" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">clevis slot</text>
    <rect x="160" y="132" width="268" height="24" rx="6" fill="var(--surface)" stroke="var(--border)"/>
    <text x="36" y="182" font-size="12" font-weight="600" fill="var(--text)">server-2</text>
    <text x="36" y="194" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">clevis slot</text>
    <rect x="252" y="172" width="360" height="24" rx="6" fill="var(--accent)"/>
    <text x="36" y="222" font-size="12" font-weight="600" fill="var(--text)">set server-1</text>
    <text x="36" y="234" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">at keystone</text>
    <rect x="160" y="212" width="360" height="24" rx="6" fill="var(--surface)" stroke="var(--border)"/>
    <text x="570" y="228" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">404</text>
    <!-- notes -->
    <path d="M160,248 V252 H428 V248" fill="none" stroke="var(--text-2)"/>
    <text x="294" y="268" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">a copy taken before the unbind opens with server-1's keys</text>
  </g>
</svg>
