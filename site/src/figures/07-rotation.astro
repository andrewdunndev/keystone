    <text x="36" y="304" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">server-1</text>
    <!-- bars -->
    <rect x="138" y="80" width="32" height="136" rx="6" fill="var(--surface)" stroke="var(--border)"/>
    <rect x="198" y="128" width="32" height="184" rx="6" fill="var(--accent)"/>
    <rect x="258" y="80" width="32" height="184" rx="6" fill="var(--surface)" stroke="var(--border)"/>
    <text x="274" y="296" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">404</text>
    <!-- notes -->
    <text x="170" y="340" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">the passphrase slot stays throughout</text>
    <text x="170" y="356" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">a copy taken before the unbind</text>
