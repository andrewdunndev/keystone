<svg class="figure-wide" viewBox="0 0 660 220" role="img" aria-label="Measured CPU per rec: P-521 at 7 ms median and up to 12 ms cold, past the Free plan's 10 ms limit; P-256 up to 6 ms cold, under it." font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" xmlns="http://www.w3.org/2000/svg">
  <g font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif">
    <rect x="20" y="20" width="620" height="180" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <!-- legend -->
    <rect x="160" y="42" width="12" height="12" rx="2" fill="var(--accent)"/>
    <text x="178" y="52" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">median</text>
    <rect x="232" y="42" width="12" height="12" rx="2" fill="var(--dd-moss-300)"/>
    <text x="250" y="52" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">up to, cold</text>
    <!-- rows -->
    <text x="36" y="92" font-size="12" font-weight="600" fill="var(--text)">P-521</text>
    <text x="36" y="104" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">default · ES512</text>
    <path d="M160,80 H382 V104 H160 Z" fill="var(--accent)"><title>P-521 median: 7 ms</title></path>
    <path d="M384,80 H540 A4,4 0 0 1 544,84 V100 A4,4 0 0 1 540,104 H384 Z" fill="var(--dd-moss-300)"><title>P-521 cold: up to 12 ms</title></path>
    <text x="374" y="96" text-anchor="end" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--accent-contrast)">7 ms median</text>
    <text x="552" y="96" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text)">12 ms cold</text>
    <text x="36" y="148" font-size="12" font-weight="600" fill="var(--text)">P-256</text>
    <text x="36" y="160" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">ES256</text>
    <path d="M160,136 H348 A4,4 0 0 1 352,140 V156 A4,4 0 0 1 348,160 H160 Z" fill="var(--dd-moss-300)"><title>P-256 cold: up to 6 ms</title></path>
    <text x="360" y="152" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text)">6 ms cold</text>
    <!-- limit -->
    <path d="M480,64 V172" fill="none" stroke="var(--text-2)" stroke-width="1.5" stroke-dasharray="4 4"/>
    <text x="480" y="52" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">Free plan: 10 ms</text>
    <!-- axis -->
    <path d="M160,72 V172" fill="none" stroke="var(--border)"/>
    <g text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" fill="var(--text-muted)">
      <text x="160" y="188">0</text>
      <text x="224" y="188">2</text>
      <text x="288" y="188">4</text>
      <text x="352" y="188">6</text>
      <text x="416" y="188">8</text>
      <text x="480" y="188">10</text>
      <text x="544" y="188">12</text>
      <text x="608" y="188">14 ms</text>
    </g>
  </g>
</svg>
