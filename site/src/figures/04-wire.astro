<svg class="figure-wide" viewBox="0 0 660 340" role="img" aria-label="The advertisement, the blinded point, the Worker's reply and the request's source cross the wire; K, the unblinded point, the ephemeral key and the slot passphrase stay on the host." font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" xmlns="http://www.w3.org/2000/svg">
  <g font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif">
    <rect x="20" y="20" width="620" height="300" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <!-- zones -->
    <rect x="36" y="52" width="284" height="252" rx="8" fill="var(--surface)" stroke="var(--border)"/>
    <rect x="48" y="46" width="96" height="12" fill="var(--bg)"/>
    <text x="96" y="55" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">CROSSES THE WIRE</text>
    <rect x="340" y="52" width="284" height="252" rx="8" fill="var(--surface)" stroke="var(--accent)"/>
    <rect x="352" y="46" width="120" height="12" fill="var(--bg)"/>
    <text x="412" y="55" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--accent)">NEVER LEAVES THE HOST</text>
    <!-- wire -->
    <rect x="52" y="72" width="252" height="48" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="68" y="92" font-size="12" font-weight="600" fill="var(--text)">signed adv</text>
    <text x="68" y="108" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">public signing and exchange keys</text>
    <rect x="52" y="128" width="252" height="48" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="68" y="148" font-size="12" font-weight="600" fill="var(--text)">X = C + e·G</text>
    <text x="68" y="164" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">blinded afresh at every boot</text>
    <rect x="52" y="184" width="252" height="48" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="68" y="204" font-size="12" font-weight="600" fill="var(--text)">Y = s·X</text>
    <text x="68" y="220" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">s stays in the Worker</text>
    <rect x="52" y="240" width="252" height="48" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="68" y="260" font-size="12" font-weight="600" fill="var(--text)">name · kid · address</text>
    <text x="68" y="276" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">log: name, address, ASN, country</text>
    <!-- host -->
    <rect x="356" y="72" width="252" height="48" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="372" y="92" font-size="12" font-weight="600" fill="var(--text)">K = s·C</text>
    <text x="372" y="108" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">unwraps the slot passphrase</text>
    <rect x="356" y="128" width="252" height="48" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="372" y="148" font-size="12" font-weight="600" fill="var(--text)">C</text>
    <text x="372" y="164" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">the stored point, unblinded</text>
    <rect x="356" y="184" width="252" height="48" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="372" y="204" font-size="12" font-weight="600" fill="var(--text)">e</text>
    <text x="372" y="220" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">this boot's ephemeral key</text>
    <rect x="356" y="240" width="252" height="48" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="372" y="260" font-size="12" font-weight="600" fill="var(--text)">slot passphrase</text>
    <text x="372" y="276" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">unwrapped by K on the host</text>
  </g>
</svg>
