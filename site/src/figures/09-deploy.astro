    <g font-family="'IBM Plex Mono', Menlo, monospace" font-size="9">
      <text x="48" y="184" fill="var(--text)">ok</text>
      <text x="128" y="184" fill="var(--text-2)">live and unchanged</text>
      <text x="48" y="198" fill="var(--text)">new</text>
      <text x="128" y="198" fill="var(--text-2)">absent, named by --new</text>
      <text x="48" y="212" fill="var(--text)">revoked</text>
      <text x="128" y="212" fill="var(--text-2)">null, answers 404</text>
      <text x="48" y="226" fill="var(--text)">REVOKED-LIVE</text>
      <text x="128" y="226" fill="var(--text-2)">null, yet served</text>
      <text x="48" y="240" fill="var(--text)">drift</text>
      <text x="128" y="240" fill="var(--text-2)">live, not in stdin</text>
      <text x="48" y="254" fill="var(--text)">REFUSE</text>
      <text x="128" y="254" fill="var(--text-2)">--url ≠ secret list, …</text>
    </g>
    <!-- stop -->
    <rect x="284" y="160" width="92" height="108" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="330" y="184" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">STOP</text>
    <text x="330" y="206" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text)">any REFUSE</text>
    <text x="330" y="218" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">exit 1</text>
    <text x="330" y="240" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text)">no --apply</text>
    <text x="330" y="252" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">exit 0, plan</text>
    <!-- checks -->
    <rect x="408" y="160" width="216" height="108" rx="6" fill="var(--surface)" stroke="var(--border)"/>
    <rect x="416" y="154" width="56" height="12" fill="var(--bg)"/>
    <text x="444" y="163" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">CHECKED</text>
    <g font-family="'IBM Plex Mono', Menlo, monospace" font-size="9">
      <text x="420" y="184" fill="var(--text)">adv</text>
      <text x="468" y="184" fill="var(--text-2)">signed by the set's key</text>
      <text x="420" y="198" fill="var(--text)">keys</text>
      <text x="468" y="198" fill="var(--text-2)">exactly the set's</text>
      <text x="420" y="212" fill="var(--text)">rec</text>
      <text x="468" y="212" fill="var(--text-2)">a real exchange answers</text>
      <text x="420" y="226" fill="var(--text)">null</text>
      <text x="468" y="226" fill="var(--text-2)">answers 404</text>
    </g>
  </g>
</svg>
