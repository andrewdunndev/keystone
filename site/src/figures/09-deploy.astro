    <text x="206" y="86" text-anchor="middle" font-size="12" font-weight="600" fill="var(--accent-contrast)">each set</text>
    <text x="206" y="102" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--accent-contrast)" opacity="0.85">vs live Worker</text>
    <rect x="284" y="44" width="92" height="80" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="330" y="70" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">GATE</text>
