    <path d="M330,124 V160" fill="none" stroke="var(--text-2)" stroke-width="1.5" marker-end="url(#deploy-arrow-muted)"/>
    <path d="M578,124 V160" fill="none" stroke="var(--text-2)" stroke-width="1.5"/>
    <!-- nodes -->
    <rect x="36" y="44" width="92" height="80" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="82" y="70" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">STDIN</text>
    <text x="82" y="86" text-anchor="middle" font-size="12" font-weight="600" fill="var(--text)">key sets</text>
    <text x="82" y="102" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">set | null</text>
