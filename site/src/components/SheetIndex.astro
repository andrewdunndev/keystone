---
import mark from '../../public/favicon.svg?raw';

interface Props {
  label: string;
  items: { id: string; label: string }[];
  numbered?: boolean;
}
const { label, items, numbered } = Astro.props;
---
<nav class="sheet-index" aria-label={label}>
  <div class="wrap">
    <a class="sheet-home" href="/" aria-label="keystone, home"><span aria-hidden="true" set:html={mark} /></a>
    <ol>
      {items.map((i, k) => <li><a href={`#${i.id}`}>{numbered && <><span>{String(k + 1).padStart(2, '0')}</span> </>}{i.label}</a></li>)}
    </ol>
  </div>
</nav>
<script is:inline>
  addEventListener("DOMContentLoaded", () => {
    const links = [...document.querySelectorAll('.sheet-index ol a')];
    const seen = new Map();
    links.forEach(a => {
      const el = document.getElementById(a.hash.slice(1));
      if (el) seen.set(el.closest('section') || el, a.hash);
    });
    const mark = hash => links.forEach(a => {
      if (a.hash === hash) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
    });
    const spy = () => {
      let cur;
      seen.forEach((hash, el) => { if (el.getBoundingClientRect().top <= innerHeight * 0.45) cur = hash; });
      mark(cur);
    };
    addEventListener('scroll', spy, { passive: true });
    addEventListener('resize', spy);
    spy();
  });
</script>
