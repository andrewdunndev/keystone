---

interface Props { fig?: string }
const { fig } = Astro.props;
const sources = import.meta.glob<string>('../figures/[0-9]*.js', { query: '?raw', import: 'default', eager: true });

/* a figure module states its step count as n in the object it returns, and
   the text beside it marks one paragraph per step */
if (fig) {
  const src = sources[`../figures/${fig}.js`];
  if (!src) throw new Error(`no figure ${fig}`);
  const drawn = Number(src.match(/return \{ n: (\d+)/)?.[1]);
  const html = await Astro.slots.render('default');
  const written = (html.match(/data-step="/g) ?? []).length || 1;
  if (drawn !== written) throw new Error(`${fig}: ${drawn} steps drawn, ${written} in the text`);
}
---
<section class:list={['chapter', { 'chapter-full': !fig }]} data-fig={fig}>
  <div class="wrap chapter-grid">
    <div class="chapter-text prose">
      <slot />
    </div>
    {fig && (
      <figure class="stage">
        <div class="stage-inner"></div>
      </figure>
    )}
  </div>
</section>
