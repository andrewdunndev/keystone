---
import { getCollection } from 'astro:content';
import FolioLayout from '@dunn.dev/reference/folio-site/FolioLayout.astro';
import FolioGuide from '@dunn.dev/reference/folio-guide/FolioGuide.astro';
import favicon from '../../../public/favicon.svg?raw';
import Colophon from '../../components/Colophon.astro';
import { nav } from '../../site.ts';
import '../../styles/figures.css';

const chapters = await getCollection('chapters');
---
<FolioLayout name="keystone" nav={nav} mark={favicon} title="Architecture" description="How keystone works: binding, unlock, key sets, their lifecycle, deploy, curves, trust, alerts and failure.">
  <FolioGuide chapters={chapters} primitives={[]} title="How keystone works" folio="Reference" deck="keystone speaks the protocol of stock tangd and serves many named key sets from one Cloudflare Worker. Deleting a set's secret revokes it." />
  <Colophon slot="colophon" />
  <script>import '../../scripts/walk.js';</script>
</FolioLayout>
