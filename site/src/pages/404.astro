---
import Layout from '../layouts/Layout.astro';
import mark from "../brand/hero-mark.svg?raw";
---
<Layout title="Not found" description="No page at this address.">
  <div class="wrap page">
    <header class="page-head head-grid">
      <div>
      <p class="folio">404</p>
      <h1 class="page-title">Not found</h1>
      <p class="deck">No page at this address. See <a href="/">Home</a> or <a href="/setup/">Install</a>.</p>
      </div>
      <div class="head-mark" aria-hidden="true" set:html={mark} />
    </header>
  </div>
</Layout>
