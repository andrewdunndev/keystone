# Copy to deploy/wrangler.toml, which git ignores, and set the route to your hostname.
# Key sets are Worker secrets named TANG_KEY_<NAME>; none belong in this file.
name = "keystone"
main = "../src/index.js"
compatibility_date = "2026-09-01"
workers_dev = false
preview_urls = false
routes = [{ pattern = "tang.example.org", custom_domain = true }]

[observability]
enabled = true
head_sampling_rate = 1

[observability.logs]
enabled = true
invocation_logs = false

# Pending approvals for sets with approvers. Declared whether or not any set uses it: Cloudflare refuses a rollback
# across a Durable Object class change, so no version that ignores allow and approvers can be rolled back to.
[[durable_objects.bindings]]
name = "GATE"
class_name = "Gate"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Gate"]

# The version id keyset compares before a policy write.
[version_metadata]
binding = "CF_VERSION_METADATA"

# Unlock alerts are off unless all four of the following are bound. Sets with approvers also need ALERT and ALERT_FROM,
# and refuse every new origin without them.

# Seen sources, cooldowns and held sources. Create the id with: npx wrangler kv namespace create UNLOCKS
# [[kv_namespaces]]
# binding = "UNLOCKS"
# id = "<namespace id>"

# Sends alerts and approval mail through Email Sending. Without destination_address it reaches any recipient.
# [[send_email]]
# name = "ALERT"

# ALERT_FROM is an address on a subdomain onboarded to Email Sending.
# [vars]
# ALERT_FROM = "unlock@mail.example.org"
# ALERT_TO = "you@example.org"

# Hourly trigger that mails the digest of held sources.
# [triggers]
# crons = ["0 * * * *"]
